# Database configuration (defaults to SQLite if unset)
DATABASE_URL=sqlite:///./brandwarden.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/brandwarden

# AI Provider: 'claude' or 'gemini'
LLM_PROVIDER=claude

# Optional Anthropic Claude API Key (if omitted, deterministic checks run seamlessly)
ANTHROPIC_API_KEY=

# Optional Google Gemini API Key
GEMINI_API_KEY=

# Server Port (default 8000)
PORT=8000
